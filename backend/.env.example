# ==============================================================================
# URL Shortener + Clickstream Analytics Platform - Environment Configuration
# ==============================================================================

# Server Runtime
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
SHORT_CODE_LENGTH=7

# CORS & Trusted Origins
# Set FRONTEND_URL to your production frontend (e.g., https://app.yourdomain.com)
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Security & Rate Limiting
# Auth endpoints rate limit (/api/auth/*)
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW_MS=900000

# General REST API rate limit (/api/urls/*, /api/analytics/*)
RATE_LIMIT_API_MAX=200
RATE_LIMIT_API_WINDOW_MS=900000

# Public Short URL redirect rate limit (/:shortCode)
RATE_LIMIT_REDIRECT_MAX=2000
RATE_LIMIT_REDIRECT_WINDOW_MS=900000

# PostgreSQL (Neon Cloud - Relational Storage)
DATABASE_URL=postgres://user:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# Upstash Redis (Cloud In-Memory Cache)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here
REDIS_URL_TTL=86400

# Aiven Apache Kafka (Cloud Event Streaming)
KAFKA_BROKERS=your-kafka-cluster.aivencloud.com:25050
KAFKA_CLIENT_ID=url-shortener-api
KAFKA_TOPIC=url-click-events
KAFKA_GROUP_ID=url-shortener-click-consumers
KAFKA_SSL=true
KAFKA_SASL_MECHANISM=plain
KAFKA_SASL_USERNAME=avnadmin
KAFKA_SASL_PASSWORD=your_aiven_kafka_password_here
KAFKA_CONNECTION_TIMEOUT=5000
KAFKA_REQUEST_TIMEOUT=10000

# ClickHouse Cloud (OLAP Analytics Database)
CLICKHOUSE_URL=https://your-service.region.gcp.clickhouse.cloud:8443
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=your_clickhouse_cloud_password_here
CLICKHOUSE_DATABASE=default
